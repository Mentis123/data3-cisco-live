# Azure AI Foundry Configuration
# Copy this file to .env and fill in your values

# The Agent Application ID (format: "agent-name:version")
AZURE_EXISTING_AGENT_ID="d3-agent-governance:5"

# Azure environment name
AZURE_ENV_NAME="agents-playground-3358"

# Azure region
AZURE_LOCATION="eastus2"

# Your Azure subscription ID
AZURE_SUBSCRIPTION_ID="your-subscription-id"

# AI Project endpoint (without /protocols suffix)
AZURE_EXISTING_AIPROJECT_ENDPOINT="https://your-resource.services.ai.azure.com/api/projects/your_project"

# Full resource ID for the AI project
AZURE_EXISTING_AIPROJECT_RESOURCE_ID="/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-resource/projects/your_project"

# Full resource ID for the Cognitive Services account
AZURE_EXISTING_RESOURCE_ID="/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-resource"

# Allow deployment to non-empty folders
AZD_ALLOW_NON_EMPTY_FOLDER=true
